# Copy this file to .env.local and fill in the values.
# On Vercel, set the same variables in Project Settings -> Environment Variables.

# --- Server-only (never exposed to the browser) ---

# Active AI provider. Currently only "openai" is implemented.
AI_PROVIDER=openai

# OpenAI API key. SECRET — keep it out of the client and out of git.
OPENAI_API_KEY=sk-...

# Vision-capable model used to read receipts.
OPENAI_MODEL=gpt-5.6-luna

# Reasoning effort for GPT-5.x models: none|minimal|low|medium|high|xhigh.
OPENAI_REASONING_EFFORT=low

# Google OAuth client ID — used server-side to verify the ID token audience.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated allowlist of emails permitted to use the AI scan. Acts as the
# bootstrap/owner list and as the fallback when the database is unreachable.
# Additional users are approved in the database (see db/schema.sql).
ALLOWED_EMAILS=you@example.com,teammate@example.com

# Comma-separated list of admins, who get the in-app "Manage access" screen for
# approving/revoking AI-scan access. Defaults to the owner account when unset.
# Deliberately env-only and never stored in the database: the admin UI writes to
# access_requests, so keeping the role out of that table means it can't grant
# admin to anyone — including itself.
ADMIN_EMAILS=you@example.com

# Neon Postgres connection string — backs the waitlist and the DB-managed
# allowlist. Optional locally: without it the allowlist is env-only and the
# waitlist endpoint responds with a friendly "unavailable" error.
# On Vercel, the Neon Marketplace integration injects this automatically.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Client-facing (VITE_ prefix is exposed to the browser) ---

# Same Google client ID, used by the Sign-In button. Client IDs are public.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Amplitude client-side API key (safe to expose — write-only, not a secret).
# Leave blank to disable analytics locally; the app runs fine without it.
VITE_AMPLITUDE_API_KEY=your-amplitude-api-key
